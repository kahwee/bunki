{
  "name": "bunki",
  "version": "0.21.2",
  "packageManager": "bun@1.4.4",
  "description": "Your words, on your own site. A Bun-powered static site generator for Markdown blogs, notes, and documentation.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "bun run typecheck && bun run build:artifacts",
    "dev": "bun run --watch src/index.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov",
    "test:watch": "bun test --watch",
    "benchmark": "bun scripts/benchmark-build.ts",
    "format": "bun fmt .",
    "format:check": "bun fmt --check .",
    "prepare": "husky",
    "typecheck": "bun --check --tsconfig-override=tsconfig.json",
    "clean": "rm -rf dist coverage",
    "prepack": "bun run clean && bun run build",
    "prepublishOnly": "bun run clean && bun run check",
    "check:source": "bun run --parallel format:check typecheck test",
    "build:artifacts": "bun run build.ts",
    "check": "bun run check:source && bun run build:artifacts"
  },
  "bin": {
    "bunki": "dist/cli.js"
  },
  "keywords": [
    "static-site-generator",
    "markdown",
    "blog",
    "bun",
    "typescript",
    "postcss",
    "tailwind",
    "css-processing",
    "jamstack",
    "web-development"
  ],
  "author": "KahWee Teng",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kahwee/bunki.git"
  },
  "bugs": {
    "url": "https://github.com/kahwee/bunki/issues"
  },
  "homepage": "https://github.com/kahwee/bunki#readme",
  "dependencies": {
    "commander": "^15.0.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.1",
    "marked-alert": "^2.1.2",
    "marked-highlight": "^2.2.4",
    "nunjucks": "^3.2.4",
    "postcss": "^8.5.30",
    "postcss-cli": "^12.0.0",
    "sanitize-html": "^2.18.0",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/nunjucks": "^3.2.6",
    "@types/sanitize-html": "^2.16.2",
    "autoprefixer": "^10.6.1",
    "bun-types": "^1.4.4",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "postcss": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "postcss": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "docs/assets",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "engineStrict": true,
  "publishConfig": {
    "access": "public"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/kahwee"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": "./dist/cli.js"
  },
  "sideEffects": false,
  "overrides": {
    "yaml": "^2.8.3",
    "picomatch": "^2.3.2",
    "js-yaml": "^3.14.2"
  }
}
